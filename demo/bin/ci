#!/usr/bin/env python3
"""Fake CI run for the demo: cargo-style compile and test output from the
real Cargo.lock and test names in the cwd, reporting progress with OSC 7501
so ttmux shows the busy spinner, then done."""
import base64, random, re, sys, time, glob

random.seed(7)
out = sys.stdout
def w(s): out.write(s); out.flush()
def status(state, progress=None, msg=None):
    body = f"state={state}:app=ci"
    if progress is not None: body += f":progress={progress}"
    if msg: body += ":msg=" + base64.b64encode(msg.encode()).decode()
    w(f"\x1b]7501;{body}\x1b\\")
G, B, C, D, R = "\x1b[1;32m", "\x1b[1m", "\x1b[36m", "\x1b[2m", "\x1b[0m"

lock = open("Cargo.lock").read()
crates = re.findall(r'name = "([^"]+)"\nversion = "([^"]+)"', lock)
crates = [c for c in crates if c[0] != "ttmux"][:60] + [("ttmux", "0.9.0")]
tests = []
for f in sorted(glob.glob("src/*.rs")):
    mod = f[4:-3]
    tests += [f"{mod}::tests::{n}" for n in re.findall(r"#\[test\]\s*fn (\w+)", open(f).read())]

w("\x1b]2;ci\x07")
n = len(crates)
for i, (name, ver) in enumerate(crates):
    w(f"{G}{'Compiling':>12}{R} {name} v{ver}\n")
    status("working", int(i * 70 / n), f"compiling {name}")
    time.sleep(random.uniform(0.08, 0.3) * (6 if name == "ttmux" else 1))
w(f"{G}{'Finished':>12}{R} `test` profile [unoptimized + debuginfo] target(s) in 11.42s\n")
w(f"{G}{'Running':>12}{R} unittests src/lib.rs (target/debug/deps/ttmux-3f9c2a71d0e4b851)\n\n")
w(f"running {len(tests)} tests\n")
for i, t in enumerate(tests):
    w(f"test {t} ... {G}ok{R}\n")
    if i % 12 == 0:
        status("working", 70 + int(i * 30 / len(tests)), "testing")
    time.sleep(random.uniform(0.0, 0.06))
w(f"\ntest result: {G}ok{R}. {len(tests)} passed; 0 failed; 0 ignored; 0 measured; finished in 2.31s\n\n")
status("done", msg=f"{len(tests)} passed")
